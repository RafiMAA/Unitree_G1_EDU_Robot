Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Ground Grid
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: odom
    - Class: rviz_default_plugins/PointCloud2
      Color: 70; 180; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Accumulated 3D Map
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.04
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /g1/map/points
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Color: 255; 190; 60
      Color Transformer: FlatColor
      Decay Time: 0.4
      Enabled: true
      Name: Live MID-360 Scan
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /g1/mid360/points
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Path
      Color: 235; 70; 90
      Enabled: true
      Head Diameter: 0.2
      Head Length: 0.15
      Length: 0.2
      Line Style: Lines
      Line Width: 0.04
      Name: Robot Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Radius: 0.05
      Shaft Diameter: 0.08
      Shaft Length: 0.1
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /g1/mapping_path
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 1
      Name: G1 Pose
      Position Tolerance: 0.1
      Shape:
        Alpha: 1
        Axes Length: 0.5
        Axes Radius: 0.04
        Color: 255; 255; 255
        Head Length: 0.15
        Shaft Length: 0.5
        Shaft Radius: 0.05
        Value: Axes
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /g1/odom
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree: {}
  Enabled: true
  Global Options:
    Background Color: 24; 27; 31
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18
      Focal Point:
        X: 7
        Y: 0
        Z: 1
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.65
      Target Frame: odom
      Yaw: 3.1
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500

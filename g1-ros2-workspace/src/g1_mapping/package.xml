<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_mapping</name>
  <version>0.1.0</version>
  <description>Live voxelized 3D mapping and RViz tools for the Unitree G1.</description>
  <maintainer email="rafiabdul7128@gmail.com">abdul-rafi</maintainer>
  <license>Apache-2.0</license>

  <depend>ament_index_python</depend>
  <depend>geometry_msgs</depend>
  <depend>g1_mujoco</depend>
  <depend>nav_msgs</depend>
  <depend>python3-numpy</depend>
  <depend>rclpy</depend>
  <depend>rviz2</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
